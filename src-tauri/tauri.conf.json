{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "String Music Player",
  "version": "1.0.0",
  "identifier": "com.muttonstring.string-music-player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "String Music Player",
        "width": 800,
        "height": 600,
        "minWidth": 400,
        "minHeight": 400,
        "transparent": true,
        "visible": false,
        "decorations": false
      },
      {
        "label": "mini",
        "title": "Mini Window",
        "create": false
      },
      {
        "label": "lyric",
        "title": "Desktop lyric",
        "dragDropEnabled": false,
        "create": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "deb", "rpm", "appimage"],
    "publisher": "Mutton String",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "both",
        "languages": [
          "Arabic",
          "Dutch",
          "English",
          "French",
          "German",
          "Italian",
          "Japanese",
          "Korean",
          "Norwegian",
          "Portuguese",
          "PortugueseBR",
          "Russian",
          "SimpChinese",
          "Spanish",
          "SpanishInternational",
          "Swedish",
          "TradChinese",
          "Turkish",
          "Ukrainian"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/32x32@2x.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/256x256@2x.png",
      "icons/512x512.png",
      "icons/512x512@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["mp3"],
        "mimeType": "audio/mp3",
        "name": "MP3",
        "role": "Viewer",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["flac"],
        "mimeType": "audio/flac",
        "name": "FLAC",
        "role": "Viewer",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["aac"],
        "mimeType": "audio/aac",
        "name": "ADTS",
        "role": "Viewer",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["wav"],
        "mimeType": "audio/wav",
        "name": "WAV",
        "role": "Viewer",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["oga", "ogg"],
        "mimeType": "audio/ogg",
        "name": "Ogg",
        "role": "Viewer",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["mp4", "m4a"],
        "mimeType": "audio/mp4",
        "name": "MP4",
        "role": "Viewer",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["webm"],
        "mimeType": "audio/webm",
        "name": "WebM",
        "role": "Viewer",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["mpg", "mpeg"],
        "mimeType": "audio/mpeg",
        "name": "MPEG",
        "role": "Viewer",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["3gp"],
        "mimeType": "audio/3gpp",
        "name": "3GP",
        "role": "Viewer",
        "androidIntentActionFilters": ["view"]
      }
    ]
  }
}
